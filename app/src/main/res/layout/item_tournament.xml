<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Name and Status -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTournamentName"
                style="@style/TextAppearance.App.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvStatus"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Summer Cup"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_booked"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="REGISTRATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer" />

        </RelativeLayout>

        <!-- Mid Row: Sport & Organizer details -->
        <TextView
            android:id="@+id/tvSportAndOrganizer"
            style="@style/TextAppearance.App.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="⚽ Football | Host: Real Madrid"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- Prize Pool Info -->
        <TextView
            android:id="@+id/tvPrizePool"
            style="@style/TextAppearance.App.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="🎁 Prize Pool: ₹10,000"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Registered Count & Linear Progress -->
        <LinearLayout
            android:id="@+id/llProgressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    style="@style/TextAppearance.App.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Seeding Registration Slots" />

                <TextView
                    android:id="@+id/tvRegisteredCount"
                    style="@style/TextAppearance.App.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="5 / 8 Teams"
                    android:textStyle="bold" />

            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTournament"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceVariant"
                tools:progress="60" />

        </LinearLayout>

        <!-- Winner Banner (Completed State) -->
        <LinearLayout
            android:id="@+id/llWinnerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/badge_booked"
            android:backgroundTint="#FFF9C4"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvWinnerTeam"
                style="@style/TextAppearance.App.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Champion: FC Barcelona"
                android:textColor="#F57F17"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
