<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar Container -->
    <FrameLayout
        android:id="@+id/fl_avatar_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circle_bg_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_player_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="JD"/>
    </FrameLayout>

    <!-- Player Name & Role -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/fl_avatar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tv_squad_player_name"
                style="@style/TextAppearance.App.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                tools:text="John Doe"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>
                
            <TextView
                android:id="@+id/tv_squad_player_jersey"
                style="@style/TextAppearance.App.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                tools:text="(#7)"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_squad_player_role"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="BATSMAN"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
