<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground">

        <!-- Avatar Container -->
        <FrameLayout
            android:id="@+id/fl_avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_bg_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_player_initials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:text="JD"/>
        </FrameLayout>

        <!-- Player Name -->
        <TextView
            android:id="@+id/tv_squad_player_name"
            style="@style/TextAppearance.App.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="John Doe"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_container"
            app:layout_constraintEnd_toStartOf="@id/card_jersey"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_squad_player_role"
            app:layout_constraintVertical_chainStyle="packed"/>

        <!-- Player Role (Premium CREX Style) -->
        <TextView
            android:id="@+id/tv_squad_player_role"
            style="@style/TextAppearance.App.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="BATSMAN"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/fl_avatar_container"
            app:layout_constraintEnd_toStartOf="@id/card_jersey"
            app:layout_constraintTop_toBottomOf="@id/tv_squad_player_name"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Jersey Number Tag -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_jersey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:cardBackgroundColor="?attr/colorSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_squad_player_jersey"
                style="@style/TextAppearance.App.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="#7"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"/>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
